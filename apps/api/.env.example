# 数据库配置
# 开发环境使用 SQLite（默认）
DATABASE_URL="file:./dev.db"

# 生产环境使用 PostgreSQL（腾讯云 TencentDB for PostgreSQL）
# DATABASE_URL="postgresql://用户名:密码@主机地址:5432/kinho?schema=public"
# 示例:
# DATABASE_URL="postgresql://kinho_user:MyPass123@10.0.0.1:5432/kinho?schema=public"

# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET="change-me-to-random-string-in-production"
