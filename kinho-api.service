[Unit]
Description=Kinho API Server (NestJS)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kinho/apps/api
Environment=NODE_ENV=production
EnvironmentFile=/opt/kinho/apps/api/.env
ExecStart=/usr/bin/node /opt/kinho/apps/api/dist/src/main.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kinho-api

[Install]
WantedBy=multi-user.target
